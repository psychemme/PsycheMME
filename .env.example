# Image-capable model endpoint (chat completions)
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=

# Text Judge endpoint
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Reuse this directory to continue the same evaluation. Change it for a new model/configuration.
RUN_DIR=runs/my-model

# Ego4D credentials from https://ego4d-data.org/docs/start-here/
EGO4D_ACCESS_KEY_ID=
EGO4D_SECRET_ACCESS_KEY=
# Optional: fill only if the official credentials include a session token.
EGO4D_SESSION_TOKEN=
# Or use an existing AWS profile / downloaded official source directory.
EGO4D_PROFILE=
EGO4D_SOURCE_DIR=
