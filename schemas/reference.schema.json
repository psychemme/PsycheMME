{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PsycheMME evaluator-only reference; legacy evidence schemas retained",
  "type": "object",
  "required": [
    "question_id",
    "episode_id",
    "media_id",
    "category",
    "task_type",
    "question",
    "options",
    "source_dataset",
    "memory_context",
    "memory_dependency",
    "answer_indices",
    "answers",
    "reference_answer",
    "evidence"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "media_id": {
      "type": "string",
      "pattern": "^video/[0-9a-f]{16}\\.mp4$"
    },
    "category": {
      "enum": [
        "G",
        "W",
        "N",
        "T",
        "S",
        "A",
        "M",
        "R"
      ]
    },
    "task_type": {
      "enum": [
        "single_choice",
        "multiple_select",
        "open"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 26
    },
    "source_dataset": {
      "type": "string",
      "minLength": 1
    },
    "memory_context": {
      "type": [
        "string",
        "null"
      ]
    },
    "memory_dependency": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reasoning_chain": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "type": "string"
        }
      ]
    },
    "timing_numeric_only_audit": {
      "type": "object"
    },
    "supplement_provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
